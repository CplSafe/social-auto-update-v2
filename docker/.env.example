# Generate via: openssl rand -hex 32
SAU_INTERNAL_TOKEN=__please_change_me_to_at_least_16_chars__

# Dify shares its redis with sau via DBs 2 and 3.
SAU_BROKER_URL=redis://:difyai123456@redis:6379/2
SAU_RESULT_BACKEND=redis://:difyai123456@redis:6379/3

SAU_LOG_LEVEL=info
# MUST be 1 until LoginSessionRegistry is Redis-backed (P3+).
SAU_API_WORKERS=1
# P2+: prefork — each worker boots its own Chromium (≈1.5GB RSS).
# Drop to 1 on tight memory; raise to 4 only on a dedicated worker host.
SAU_WORKER_CONCURRENCY=2
# P2 publish drives Playwright; gevent breaks asyncio. Override only for
# pure stub-task debugging.
SAU_WORKER_POOL=prefork
# Where /postVideo writes the uploaded bytes before the worker picks them
# up. Worker unlinks each file in the task's `finally` clause.
SAU_TMP_DIR=/app/sau_data/tmp

# REQUIRED. Confirm via `docker network ls` AFTER Dify is up; the value
# depends on Dify's compose project directory name (often `dify_default`,
# sometimes `docker_default`). No safe default exists — pick one.
SAU_NETWORK_NAME=
